# Copy to .env and fill in. Use letters and digits only in passwords (they go into a URL):
#   openssl rand -hex 24
DB_USER=edu
DB_NAME=educenter
DB_PASSWORD=

# Signs every login; at least 32 characters. Changing it signs everyone out once.
JWT_SECRET=

# The first super admin is created from these when there is none yet (password 8+ characters).
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Optional: the super admin panel (/super) answers only at this address, e.g. admin.example.com
SUPER_HOST=

# Mail for centres that have no SMTP settings of their own (each centre can set its own in /super).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

# The web app listens on BIND:PORT. Keep 127.0.0.1 and put nginx (HTTPS) in front of it;
# BIND=0.0.0.0 opens it straight on the server's IP (for a first look, no HTTPS).
BIND=127.0.0.1
PORT=3000
